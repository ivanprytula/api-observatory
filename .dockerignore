# .dockerignore for Python/FastAPI project

# Bytecode / compiled Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Database files
*.db
*.sqlite3

# Logs
*.log

# Coverage reports
*.coverage
.coverage*
.cache/

# Test caches
.pytest_cache/
.mypy_cache/
.hypothesis/

# Virtual environment (massive, kills build context)
.venv/

# Environment files
.env
.env.*

# Editors / IDE
.vscode/
.idea/
.cursor/
*.swp
*.swo
.DS_Store

# Node
node_modules/

# Build artifacts
dist/
build/
.eggs/
*.egg-info/
*.egg

# Agent / AI tooling artifacts (large, irrelevant in images)
.kilo/
.copilot/
.learnings/
.codex/
.playwright-mcp/
.remember/
.pre-commit-cache/

# Terraform state/cache
.terraform/

# Streamlit local config (needed in dashboard image for theme)
# .streamlit/

# Repo metadata (never needed in images)
.git/
.github/

# Documentation
docs/
_archive/
*.md

# Local dev / planning artifacts
.local-dev/
learning_docs/
examples/
scripts/*
!scripts/seed_admin.py
bruno/
event.json
secrets-findings.json

# Task runner and orchestration (not needed in images)
Justfile
justfile
docker-compose*.yml

# Local volumes
pg_data/

# Coverage reports
htmlcov/
cover/

# Generated certificates (HTTPS setup)
infra/certs/
*.pem

# Application logs
logs/
