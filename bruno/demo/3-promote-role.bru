meta {
  name: Promote to Admin (internal)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/users/{{username}}/role
  body: json
  auth: bearer
}

auth:bearer {
  token: {{internal_token}}
}

body:json {
  {
    "role": "admin"
  }
}

assert {
  res.status: eq 200
  res.body.role: eq "admin"
}
