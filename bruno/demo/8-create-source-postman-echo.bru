meta {
  name: Create Source postman-echo
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/sources
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "name": "postman-echo",
    "base_url": "https://postman-echo.com",
    "health_check_path": "/get",
    "probe_interval_seconds": 10,
    "is_active": true
  }
}

assert {
  res.status: in [201, 409]
}
