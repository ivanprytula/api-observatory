meta {
  name: Create Source jsonplaceholder-posts
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/sources
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "name": "jsonplaceholder-posts",
    "base_url": "https://jsonplaceholder.typicode.com",
    "health_check_path": "/posts/1",
    "probe_interval_seconds": 10,
    "is_active": true
  }
}

assert {
  res.status: in [201, 409]
}
