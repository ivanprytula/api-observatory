meta {
  name: Create Source
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/sources
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "name": "httpbin-3",
    "base_url": "https://httpbin.org",
    "health_check_path": "/get",
    "probe_interval_seconds": 10
  }
}

assert {
  res.status: in [201, 409]
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("source_id", res.body.id.toString());
  }
}
