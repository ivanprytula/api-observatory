meta {
  name: Enrich observation (HITL review — pauses before publish)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/agent/enrich/{{observation_id}}/review
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

# post-MVP: assertions deferred until OPENAI_API_KEY is configured
assert {
  res.status: in [200, 500]
}

script:post-response {
  if (res.status === 200 && res.body.run_id) {
    bru.setEnvVar("run_id", res.body.run_id);
  }
}
