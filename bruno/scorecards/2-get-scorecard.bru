meta {
  name: Get Scorecard for Source
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/scorecards/{{source_id}}
  body: none
  auth: bearer
}

params:query {
  ~days: 1
}

auth:bearer {
  token: {{access_token}}
}

example {
  name: example

  request: {
    url: {{baseUrl}}/api/v1/scorecards/{{source_id}}
    method: GET
    mode: none
    params:query: {
      ~days: 1
    }
  }

