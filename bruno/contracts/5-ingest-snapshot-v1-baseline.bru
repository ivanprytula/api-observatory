meta {
  name: Ingest snapshot v1 — baseline
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/contracts/snapshots
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "source_id": {{drift_source_id}},
    "payload_schema": {
      "userId": "integer",
      "id": "integer",
      "title": "string",
      "body": "string"
    },
    "schema_version": "1.0.0",
    "snapshot_note": "Drift demo baseline — all fields present"
  }
}

assert {
  res.status: eq 201
  res.body.drift_event: eq null
}
