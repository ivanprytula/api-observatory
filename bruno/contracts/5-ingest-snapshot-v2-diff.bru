meta {
  name: Ingest snapshot v2 — drift trigger
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/contracts/snapshots
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "source_id": {{source_id}},
    "payload_schema": {
      "userId": "integer",
      "id": "integer",
      "body": "string"
    },
    "schema_version": "2.0.0",
    "snapshot_note": "After migration — title field removed"
  }
}

assert {
  res.status: eq 201
  res.body.drift_event.event_type: eq breaking
}

script:post-response {
  if (res.body.drift_event) {
    bru.setEnvVar("drift_event_id", res.body.drift_event.id.toString());
  }
}
