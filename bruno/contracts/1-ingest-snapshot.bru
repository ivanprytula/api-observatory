meta {
  name: Ingest Snapshot
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/contracts/snapshots
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "source_id": {{source_id}},
    "payload_schema": {
      "args": {},
      "headers": {},
      "origin": "",
      "url": ""
    },
    "schema_version": "v1"
  }
}
