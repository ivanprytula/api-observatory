meta {
  name: Get Agent Run
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/agent/runs/{{agent_run_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

assert {
  res.status: eq 200
}

docs {
  Poll this (re-run) until `status` is `awaiting_review` before calling
  request 5. See request 3's docs for how to find `agent_run_id`.
}
