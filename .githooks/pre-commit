#!/usr/bin/env bash
set -euo pipefail

# Shareable pre-commit hook for contracts changes.
# Enable by setting: git config core.hooksPath .githooks

# Ensure we run from the repository root
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$REPO_ROOT" || exit 1

# Run repository pre-commit hooks (ruff/format/markdown/etc.) on staged files.
uv run pre-commit run

