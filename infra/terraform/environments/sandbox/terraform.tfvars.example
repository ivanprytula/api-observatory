# Sandbox tfvars example — works with Floci, LocalStack, or any S3-compatible emulator.
# Copy to terraform.tfvars (gitignored) and adjust emulator_endpoint if needed.
#
# Sandbox mode: infrastructure-only (VPC, ALB, ECS tasks in mock mode).
# Compose provides db/redis/redpanda on fixed ports — skip those Terraform modules
# to avoid port conflicts. ECR/registry sidecar can't start in rootless Docker,
# so image URIs are hardcoded below and ECS_MOCK=true skips container pulls.

aws_region         = "eu-central-1"
aws_profile        = "sandbox"
emulator_endpoint  = "http://localhost:4566"

vpc_cidr           = "10.0.0.0/16"
availability_zones = ["eu-central-1a", "eu-central-1b"]
image_tag          = "develop"
ecr_services       = []

# All disabled — compose provides these on host ports
enable_messaging = false
enable_iam       = false
enable_database  = false
enable_cache     = false

db_master_password   = "local-dev-db-password"
db_subnet_group_name = null
redis_auth_token     = "local-dev-redis-token"
