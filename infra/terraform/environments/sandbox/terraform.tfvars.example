# Sandbox tfvars — works with Floci (real containers via mounted Docker socket).
# Copy to terraform.tfvars (gitignored) and adjust if needed.
#
# Prerequisites:
#   docker compose --profile aws up -d floci
#   docker run -d --name floci-ecr-registry \
#     --network api-observatory_api-obs -p 5100:5000 registry:2
#   TF_ENV=sandbox just tf plan && TF_ENV=sandbox just tf apply
#   just floci-deploy

aws_region         = "eu-central-1"
aws_profile        = "sandbox"
emulator_endpoint  = "http://127.0.0.1:4566"

vpc_cidr           = "10.0.0.0/16"
availability_zones = ["eu-central-1a", "eu-central-1b"]
image_tag          = "develop"
ecr_services       = ["ingestor", "dashboard"]

enable_messaging = false
enable_iam       = false
enable_database  = true
enable_cache     = true

db_master_password   = "local-dev-db-password"
db_subnet_group_name = null
redis_auth_token     = "local-dev-redis-token"
