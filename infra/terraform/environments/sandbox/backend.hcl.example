# Sandbox backend config (Floci / LocalStack / any S3-compatible emulator).
# Copy to backend.hcl (gitignored) and adjust bucket/endpoint as needed.

bucket                      = "s3-native-lock-setup"
key                         = "data-zoo/sandbox/terraform.tfstate"
region                      = "eu-central-1"
access_key                  = "test"
secret_key                  = "test"
use_lockfile                = true
endpoints = {
	s3 = "http://localhost:4566"
}
use_path_style              = true
skip_credentials_validation = true
skip_metadata_api_check     = true
skip_region_validation      = true
skip_requesting_account_id  = true
