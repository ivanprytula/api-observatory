# LocalStack/Floci overlay for terraform.tfvars
# Copy to terraform.floci.tfvars (gitignored)

enable_messaging               = false
enable_iam                     = false
enable_database                = true
enable_cache                   = false
nat_gateway_count              = 0
ecr_services                   = ["ingestor", "processor"]

# LocalStack-compatible DB settings
db_manage_master_user_password = false
db_create_subnet_group         = false
db_subnet_group_name           = null
db_master_password             = "local-dev-db-password"

# Required for cache module if enabled later
redis_auth_token               = "local-dev-redis-token"
