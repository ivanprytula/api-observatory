# Real AWS dev overlay for terraform.tfvars
# Copy to terraform.aws.tfvars (gitignored)

enable_messaging               = false
enable_iam                     = true
enable_database                = true
enable_cache                   = true
nat_gateway_count              = 1
ecr_services                   = ["ingestor"]

# Real AWS defaults for RDS
db_manage_master_user_password = true
db_create_subnet_group         = true
db_subnet_group_name           = null
# db_master_password not needed when db_manage_master_user_password=true

# Use secrets manager / TF_VAR_redis_auth_token
# redis_auth_token = "<set via TF_VAR_redis_auth_token>"
