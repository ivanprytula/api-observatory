# LocalStack backend config for local Terraform workflows.
# Copy to backend.local.hcl (gitignored) and adjust if needed.

bucket                      = "data-pipeline-local"
key                         = "data-zoo/dev/terraform.tfstate"
region                      = "eu-central-1"
access_key                  = "test"
secret_key                  = "test"
use_lockfile                = true
endpoints = {
	s3 = "http://localhost:4566"
}
use_path_style              = true
skip_credentials_validation = true
skip_metadata_api_check     = true
skip_region_validation      = true
skip_requesting_account_id  = true
