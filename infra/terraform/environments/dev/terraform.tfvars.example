# terraform.tfvars — shared dev base values
# Keep this file environment-agnostic. Context-specific values belong in:
# - terraform.floci.tfvars      (LocalStack/Floci)
# - terraform.aws.tfvars        (real AWS)
#
# Copy this file to terraform.tfvars and fill in your shared defaults.
#
# Usage with AWS CLI profile:
#   export TF_VAR_aws_profile=data-zoo-dev
#   export TF_VAR_redis_auth_token=$(aws ssm get-parameter \
#     --name "/data-zoo/dev/redis-auth-token" \
#     --with-decryption --query Parameter.Value --output text \
#     --profile data-zoo-dev)
#   terraform apply

aws_region         = "us-east-1"  # LocalStack default region for local workflows
aws_profile        = "default"
vpc_cidr           = "10.0.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b"]
github_repository  = "ivanprytula/api-observatory"
image_tag          = "develop"
ecr_services       = ["ingestor", "processor"]

# ACM certificate ARN for your domain (create in AWS console, then set here)
# acm_certificate_arn = "arn:aws:acm:eu-central-1:123456789012:certificate/..."
