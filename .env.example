# Copy this file to the ignored .env before starting a local workflow:
#   cp .env.example .env
#   just generate-secrets
#
# This file is a public template and contains no credentials. Copy it to the
# ignored .env, then run `just generate-secrets`. The generator adds the local
# database, Redis, bearer-token, and JWT values using short names and keeps
# .env user-readable only (0600). Compose maps those local values to the
# process-level variables; production receives its values through
# infrastructure-owned secret delivery.

ENVIRONMENT=development
LOG_LEVEL=INFO
# HTTP is the default local stack. Configure certificates and enable the
# ingress profile only when testing HTTPS-specific behavior.
LOCAL_HTTPS=false

# Optional capabilities are disabled for the core setup. Enable and configure
# a capability only through its own documented workflow.
CACHE_ENABLED=false
BROKER_ENABLED=false
OTEL_ENABLED=false
OPENAI_ENABLED=false
ANTHROPIC_ENABLED=false

WEBSOCKET_ENABLED=false

# ── Monitoring auth ──────────────────────────────────────────────────────────
# Local dev keeps Grafana anonymous for convenience. In cloud/CI set
# GRAFANA_AUTH_ENABLED=true and provide the admin credentials below.
# The remaining monitoring tools (Prometheus, Loki, Tempo, Alertmanager,
# Mailpit) currently run without auth in local dev and must be fronted by
# a reverse proxy or have their own auth flags set in cloud.
GRAFANA_AUTH_ENABLED=false
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
MAILPIT_AUTH_ENABLED=false
MAILPIT_USER=mailpit
MAILPIT_PASSWORD=mailpit
