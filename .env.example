# Copy this to .env and fill in your local values
#
# MVP full-feature stack requires:
#   REDIS_ENABLED=true     → cache, pub/sub, rate limiting, agent checkpointer
#   KAFKA_ENABLED=true     → drift event streaming via Redpanda
#   OPENAI_API_KEY=...     → LangGraph agent enrichment (all other endpoints work without it)
#
# docker-compose.yml sets REDIS_URL, KAFKA_BROKER_URL, SERVICE_VERSION automatically.
# You only need this file when running the ingestor outside Docker.

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/api_observatory

# App
ENVIRONMENT=development
LOG_LEVEL=DEBUG
LOG_SQLALCHEMY_LEVEL=WARNING
LOG_HTTPX_LEVEL=WARNING
LOG_ASYNCIO_LEVEL=WARNING

# Documentation Authentication (optional)
# Leave empty to allow public access to /docs, /redoc, /openapi.json
# Set both to enable HTTP Basic Auth protection on docs endpoints
# ⚠️  Dev defaults — use strong credentials or clear both values in non-local environments
DOCS_USERNAME=admin
DOCS_PASSWORD=changeme

# API Authentication — v1 (Token-based + Session)
# ⚠️  Dev default — replace with a strong random value in staging and production
API_V1_BEARER_TOKEN=dev-secret-bearer-token
TOKEN_EXPIRY_HOURS=24

# API Authentication — v2 (JWT)
JWT_SECRET=your-super-secret-key-at-least-32-characters-long-change-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# Redis
# Set REDIS_ENABLED=true to enable: scorecard cache (SETEX 30s), WebSocket pub/sub fan-out,
# JWT session store, slowapi rate limiting backend, LangGraph agent checkpointer.
# When false: in-memory fallback for rate limits, MemorySaver for agent, no live WS events.
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
# Inside Docker Compose network: redis://redis:6379/0 (set automatically in docker-compose.yml)

# Kafka / Redpanda
# Set KAFKA_ENABLED=true to enable: drift event publishing from probe scheduler → WebSocket push.
# Redpanda is Kafka-compatible (no JVM). Internal address: redpanda:29092 (Docker network).
# External (host machine): localhost:9092
# When false: probe results write to DB only; WebSocket clients receive no live events.
KAFKA_ENABLED=true
KAFKA_BROKER_URL=localhost:9092
# Inside Docker Compose: KAFKA_BROKER_URL=redpanda:29092 (set automatically in docker-compose.yml)

# OpenAI (LangGraph agent enrichment)
# Required only for POST /api/v1/agent/* endpoints.
# All other endpoints (sources, scorecards, drift, WebSocket) work without this key.
# Dual-model usage: gpt-4o-mini for classify (~500ms, cheap), gpt-4o for deep_analyze (~1-2s).
OPENAI_API_KEY=sk-your-real-key-here

# OpenTelemetry (distributed tracing → Jaeger)
# Set OTEL_ENABLED=true when running with docker compose (Jaeger is included)
OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=api-obs-ingestor

# Sentry / GlitchTip (error tracking)
# For self-hosted GlitchTip: set SENTRY_DSN to the DSN from http://localhost:8010 after first login
# First-run step: docker compose --profile monitoring exec glitchtip ./manage.py createsuperuser
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=false

# GlitchTip service secrets (used by docker-compose monitoring profile)
GLITCHTIP_DB_PASSWORD=glitchtip
GLITCHTIP_SECRET_KEY=change-me-in-production-at-least-50-chars-random
GLITCHTIP_DOMAIN=http://localhost:8010

# S3 backup (used by infra/scripts/backup.sh + restore.sh)
# BACKUP_STORAGE: local | s3 | both (default: local)
# AWS_ENDPOINT_URL: set to http://localhost:4566 for Floci, leave empty for real AWS
BACKUP_STORAGE=local
BACKUP_S3_BUCKET=api-observatory-backups
BACKUP_S3_PREFIX=backups/
AWS_ENDPOINT_URL=http://localhost:4566

# Background workers (Pillar 5 prototype)
BACKGROUND_WORKERS_ENABLED=false
BACKGROUND_WORKER_COUNT=2
BACKGROUND_WORKER_QUEUE_SIZE=200
BACKGROUND_MAX_TRACKED_TASKS=500
