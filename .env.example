# Copy this file to the ignored .env before starting a local workflow:
#   cp .env.example .env
#   just generate-secrets
#
# This file is a public template and contains no credentials. Copy it to the
# ignored .env, then run `just generate-secrets`. The generator adds the local
# database, Redis, bearer-token, and JWT values under the API_OBS_ local
# namespace and keeps .env user-readable only (0600). Compose maps those local
# values to the process-level variables; production receives its values through
# infrastructure-owned secret delivery.

ENVIRONMENT=development
LOG_LEVEL=INFO
# HTTP is the default local stack. Configure certificates and enable the
# ingress profile only when testing HTTPS-specific behavior.
API_OBS_LOCAL_HTTPS=false

# Optional capabilities are disabled for the core setup. Enable and configure
# a capability only through its own documented workflow.
API_OBS_CACHE_ENABLED=false
API_OBS_BROKER_ENABLED=false
API_OBS_OTEL_ENABLED=false
API_OBS_OPENAI_ENABLED=false
API_OBS_ANTHROPIC_ENABLED=false
