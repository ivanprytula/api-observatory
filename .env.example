# Copy this file to the ignored .env before starting a local workflow:
#   cp .env.example .env
#   just generate-secrets
#
# This file holds public, non-secret development configuration only. The
# generator adds private credentials to .env; production injects the same
# variables through infrastructure-owned secret delivery.

ENVIRONMENT=development
LOG_LEVEL=INFO
LOCAL_HTTPS=false

# Optional capabilities are disabled for the core setup. Enable and configure
# a capability only through its own documented workflow.
CACHE_ENABLED=false
BROKER_ENABLED=false
OTEL_ENABLED=false
OPENAI_ENABLED=false
ANTHROPIC_ENABLED=false
